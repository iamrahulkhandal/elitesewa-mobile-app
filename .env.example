# Copy this file to .env and fill in real values

# Backend base URL (e.g. http://10.0.2.2:5001 for Android emulator)
REACT_NATIVE_SERVER_URL=

# API base URL (if different from REACT_NATIVE_SERVER_URL)
API_URL=

# Razorpay
RAZORPAY_KEY_ID=

# Google Maps / Geocoding
GOOGLE_API_KEY=

# App environment
# Example: false for dev, true for production
PROD=
