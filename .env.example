# Copy this file to .env and fill in real values

# Backend API base URL
# Local testing: http://localhost:5007 (run `adb reverse tcp:5007 tcp:5007` for Android emulator)
# Production: https://elitesewa-api.thinklytixai.com
API_URL=

# Razorpay
RAZORPAY_KEY_ID=

# Google Maps / Geocoding
GOOGLE_API_KEY=

# App environment
# Example: false for dev, true for production
PROD=
